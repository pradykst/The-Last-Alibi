# Safe public development default. This is a mode declaration, not a partner-integration claim.
ALIBI_RUNTIME_MODE=fixture

# Public deployment metadata. Override with the deployed HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional fixture-session persistence (server only). Use an absolute path on a hosted volume.
# ALIBI_FIXTURE_STORE_PATH=/var/lib/the-last-alibi/fixture-sessions.json

# Live Sui public identifiers. Use the testnet evidence IDs or a separately verified deployment.
# ALIBI_SUI_NETWORK=testnet
# ALIBI_SUI_CHAIN_IDENTIFIER=<testnet-genesis-checkpoint-digest>
# ALIBI_SUI_PACKAGE_ID=<deployed-package-object-id>
# ALIBI_SUI_LEVEL_CONFIG_ID=<deployed-level-config-object-id>
# ALIBI_SUI_SIGNER_ADDRESS=<server-relayer-sui-address>

# Live Sui server-only configuration. The signer secret must remain unset in committed files.
ALIBI_SUI_RPC_URL=
ALIBI_SUI_SIGNER_SECRET_KEY=
ALIBI_SUI_OPERATION_PATH=/var/lib/the-last-alibi/sui-operations

# Server-only Groth16 prover executable and artifact paths. Hosted values must be absolute.
ALIBI_PROVER_BINARY_PATH=
ALIBI_QUERY_WASM_PATH=
ALIBI_QUERY_R1CS_PATH=
ALIBI_QUERY_PROVING_KEY_PATH=
ALIBI_QUERY_VERIFYING_KEY_PATH=
ALIBI_VERDICT_WASM_PATH=
ALIBI_VERDICT_R1CS_PATH=
ALIBI_VERDICT_PROVING_KEY_PATH=
ALIBI_VERDICT_VERIFYING_KEY_PATH=

# Verified 0G suspect testimony (server only). Fixture mode does not require these.
# ALIBI_ZERO_G_MODE=live
# ZERO_G_NETWORK=<testnet-or-mainnet-label>
# ZERO_G_RPC_URL=<https-rpc-url>
# ZERO_G_PROVIDER_ADDRESS=<catalog-provider-address>
# ZERO_G_MODEL=<catalog-model-identifier>
# ZERO_G_SERVICE_TYPE=chatbot
# ZERO_G_VERIFICATION_MODE=<TeeML-or-TeeTLS>
# ZERO_G_REQUEST_TIMEOUT_MS=15000
# ZERO_G_MAX_RESPONSE_BYTES=65536
# ZERO_G_REQUIRE_PROVIDER_VERIFICATION=<true-or-false>
# ZERO_G_REQUIRE_RESPONSE_VERIFICATION=true
# ZERO_G_PRIVATE_KEY=<externally-supplied-server-secret>

# World AgentKit protected-resource configuration (server only).
# The resource URI must be the deployed protected endpoint; example.com placeholders are rejected.
ALIBI_AGENTKIT_RESOURCE_URI=
ALIBI_AGENTKIT_LEVEL_ID=the-last-exhibit
ALIBI_AGENTKIT_NETWORK=eip155:480
ALIBI_AGENTKIT_MAX_AGE_MS=120000
ALIBI_AGENTKIT_WORLD_RPC_URL=
ALIBI_AGENTKIT_SIGNATURE_RPC_URL=

# World replay/entitlement persistence and secret (server only). Mount the parent directory.
ALIBI_AGENTKIT_STORE_PATH=/var/lib/the-last-alibi/world-agentkit-entitlements.json
ALIBI_AGENTKIT_ENTITLEMENT_SECRET=

# Live-evidence client inputs. The Sui recipient is the player wallet, not the World EVM agent.
ALIBI_AGENTKIT_AGENT_ADDRESS=
ALIBI_AGENTKIT_AGENT_PRIVATE_KEY=
ALIBI_AGENTKIT_SUI_RECIPIENT=
ALIBI_AGENTKIT_EVIDENCE_PATH=docs/evidence/world-agentkit-live.json
